diff --git a/main/audio/audio_codec.cc b/main/audio/audio_codec.cc
index 03e2baa..c66f28c 100644
--- a/main/audio/audio_codec.cc
+++ b/main/audio/audio_codec.cc
@@ -15,6 +15,12 @@ AudioCodec::~AudioCodec() {
 }
 
 void AudioCodec::OutputData(std::vector<int16_t>& data) {
+    if (on_audio_level_) {
+        int64_t sum = 0;
+        for (int16_t sample : data) sum += sample < 0 ? -sample : sample;
+        float mean_abs = data.empty() ? 0.0f : (float)sum / data.size();
+        on_audio_level_(mean_abs / 32768.0f);
+    }
     Write(data.data(), data.size());
 }
 
